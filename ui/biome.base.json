{
  "$schema": "https://biomejs.dev/schemas/2.6.8/schema.json",

  "files": {
    "includes": ["**", "!**/dist/**", "!**/node_modules/**", "!**/coverage/**", "!**/generated/**"]
  },

  "vcs": { "enabled": false, "clientKind": "git", "useIgnoreFile": true },

  "formatter": {
    "enabled": true,
    "indentStyle": "space",
    "indentWidth": 2,
    "lineWidth": 100,
    "lineEnding": "lf",
    "attributePosition": "auto",
    "bracketSpacing": true,
    "expand": "auto",
    "useEditorconfig": true
  },

  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended",

      "style": {
        "preset": "recommended",
        "useConst": "error",
        "useImportType": "error",
        "useExportType": "error",
        "noNonNullAssertion": "error"
      },

      "suspicious": {
        "preset": "recommended",
        "noExplicitAny": "error",
        "noConsole": { "level": "warn" },
        "noArrayIndexKey": "error"
      },
      "complexity": {
        "preset": "recommended",
        "noExcessiveCognitiveComplexity": {
          "level": "error",
          "options": { "maxAllowedComplexity": 15 }
        }
      },

      "correctness": {
        "preset": "recommended",
        "useExhaustiveDependencies": "warn"
      },

      "performance": {
        "preset": "recommended"
      },

      "security": {
        "preset": "recommended"
      }
    }
  },

  "javascript": {
    "formatter": {
      "quoteStyle": "single",
      "semicolons": "always",
      "trailingCommas": "all",
      "arrowParentheses": "always"
    }
  },

  "json": {
    "formatter": {
      "enabled": true,
      "trailingCommas": "none"
    }
  }
}
